{
  "name": "sdacs-simulator",
  "version": "1.5.0",
  "private": true,
  "description": "SDACS Desktop Simulator v1.4 — 150 Phase 통합 (MEGA 9 + HYPER 41 + STELLAR 49 + ULTIMATE 50 + Phase 51 시드 = Phase 150 Universe OS 도달, 330+ API)",
  "author": "SDACS Capstone Team, Mokpo National University",
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "pack": "electron-builder --dir",
    "build:simulator": "python scripts/build_simulator.py",
    "build:simulator:check": "python scripts/build_simulator.py --check",
    "smoke": "node tests/e2e/smoke_sim.mjs",
    "smoke:maritime": "node tests/e2e/smoke_maritime.mjs",
    "pw:install": "playwright install chromium",
    "test-server": "python -m http.server 8123"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "playwright": "1.62.0"
  },
  "build": {
    "appId": "com.sdacs.simulator",
    "productName": "SDACS Simulator",
    "copyright": "© 2026 SDACS Capstone, Mokpo National University",
    "directories": {
      "output": "dist-desktop",
      "buildResources": "desktop/build-resources"
    },
    "files": [
      "desktop/**/*",
      "swarm_3d_simulator.html",
      "maritime_detection_simulator.html",
      "manifest.webmanifest",
      "sdacs-sw.js",
      "vendor/three/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/three/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-python/sdacs-backend",
        "to": "sdacs-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis-web",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SDACS-Simulator-${version}-${arch}.${ext}"
    },
    "nsisWeb": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SDACS Simulator"
    },
    "portable": {
      "artifactName": "SDACS-Simulator-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SDACS Simulator"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "SDACS-Simulator-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Science",
      "artifactName": "SDACS-Simulator-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "sun475300-sudo",
      "repo": "swarm-drone-atc",
      "releaseType": "draft"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
